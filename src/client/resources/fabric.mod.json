            "com.minepiece.essentials.MinepieceEssentialsClient"
        ]
    },
    "mixins": [
        "minepiece-essentials.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.2",
        "java": ">=25",
